# Default deny: new root files and directories require an explicit allow rule.
/*
!/.gitignore
!/README.md
!/requirements.txt
!/config.yaml
!/train_sac_delay.py
!/evaluate_sac_delay.py

# Project directories allowed in version control.
!/src/
!/assets/
!/sumo_files/
!/sumo_new/
!/models/

# Only the two distributed pretrained models are allowed under models/.
/models/*
!/models/GRU-uniform-delay/
/models/GRU-uniform-delay/*
!/models/GRU-uniform-delay/GRU-uniform-delay.zip
!/models/GRU-uniform-delay/GRU-uniform-delay_best.zip

# AI workspace files and temporary output, including inside allowed directories.
.codex/
.claude/
.cursor/
.agents/
AGENTS.md
CLAUDE.md
tmp/
temp/
scratch/
artifacts/
*.tmp
*.bak

# macOS and local editor settings
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Python caches, virtual environments, and build output
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Local credentials (keep shareable example files)
.env
.env.*
!.env.example
!.env.sample

# Generated training logs and experimental checkpoints
wandb/
runs/
logs/
outputs/
multirun/
models_experiments/
*.log
# The pretrained checkpoints in models/ are intentionally included.

# Generated SUMO simulation results
tripinfo.xml
E1_DS*_L*.xml
